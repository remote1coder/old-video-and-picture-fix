+MEDIA_SUFFIXES = frozenset({
+    ".mkv", ".mp4", ".mov", ".avi", ".webm", ".m2ts", ".ts",
+    ".mka", ".wav", ".flac", ".aac", ".ac3",
+    ".png", ".tif", ".tiff", ".jpg", ".jpeg", ".bmp",
