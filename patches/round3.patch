+def _make_multichannel_wav(path, freqs=(220, 330, 440, 550, 660, 770),
+                           layout="5.1", seconds=1.0, rate=48000):
+    """合成 N 声道素材：每个声道放**不同**频率，便于检测是否被合并。"""
