+guard = CancelGuard()
+
+
+def install_cancel_guard(stage: Optional[int] = None,
+                         logger: Any = None) -> bool:
+    """Install the process-wide cancel guard. See :meth:`CancelGuard.install`."""
+    return guard.install(stage=stage, logger=logger)
