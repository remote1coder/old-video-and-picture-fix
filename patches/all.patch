+            self.returncode = rc
+            self.stderr = ""
+
+    packets = "".join(
+        f"{i * 0.04:.6f},0.040000\n" for i in range(50))  # 50 帧 × 40ms = 2.0s
+
+    def fake_run(cmd, *a, **k):
