+def test_r204_video_startup_does_not_clobber_concurrent_done(tmp_path,
+                                                             monkeypatch):
+    """R2-04 等价反例：视频启动期不得用旧快照把并发写好的 DONE 盖回 PENDING。
+
+    与独立用例 A09 同一注入设置；这里不依赖"启动期一定会整表写盘"这一前提，
+    而是直接断言磁盘最终状态（因此更强）。
+    """
+    path = _cli_env(tmp_path, monkeypatch, 0)
+    original_load = vmain.load_manifest
+    injected = {"done": False}
+
+    def stale_load(p):
+        old = original_load(p)
+        if str(p) == path and not injected["done"]:
+            injected["done"] = True
+            gen = ml.acquire_run_ownership(path, ["j1"], owner="concurrent-A")
+            assert ml.save_manifest_job_result(
+                path, "j1", "DONE", owner="concurrent-A", generation=gen)
+        return old          # 本次进程拿到的是**注入前**的旧快照
+
+    # 必须在"作业真正被处理之前"停下来看磁盘：否则后面 job 处理完又会写一次
+    # DONE，把启动期的覆盖掩盖掉（第一版用例就是这样在基线上也通过的）。
+    class _Stop(Exception):
+        pass
+
+    def _boom(*_a, **_k):
+        raise _Stop()
+
+    monkeypatch.setattr(vmain, "load_manifest", stale_load)
+    monkeypatch.setattr(vmain, "process_job", _boom)
+    try:
+        vmain.main()
+    except _Stop:
+        pass
+    except SystemExit:
+        pass
+    final = ml.load_manifest(path)
+    assert final["jobs"][0]["status"] == "DONE", (
+        "视频启动期用旧快照整表覆盖，把并发运行的 DONE 打回 "
+        f"{final['jobs'][0]['status']}（R2-04）")
+
+
+def test_r205_photo_scheduler_persists_completed_job_without_waiting(
+        tmp_path, monkeypatch):
+    """R2-05：已完成的 job 不得被前面那个慢 job 挡住落盘。
+
+    驱动**真正的 photo main() 调度入口**：
+      * job A 在 worker 里阻塞（等事件）；job B 立即返回；
+      * A 只有在"读到磁盘上 B 已是 DONE"之后才放行 —— 这消除了竞态，
+        如果父进程是按提交顺序 future.get() 阻塞，A 永远等不到 B 落盘，
+        于是断言失败。
+    进程池换成线程池，是为了让父进程里替换的 _run_single_job 在 worker 中
+    可见（spawn 子进程看不到 monkeypatch）；被测对象是**父进程的收集逻辑**，
+    这正是 R2-05 的缺陷所在。
+    """
+    import importlib.util as _ilu
+    import multiprocessing as _mp
+    import multiprocessing.pool as _mppool
+    import threading
+
+    pmain_path = os.path.join(ROOT, "photo_restoration_pipeline", "main.py")
+    spec = _ilu.spec_from_file_location("photo_main_r205", pmain_path)
+    pmain = _ilu.module_from_spec(spec)
+    spec.loader.exec_module(pmain)
+
+    manifest_path = str(tmp_path / "m.jsonl")
+    jobs = [{"job_id": "A", "status": "PENDING", "input_path": "a.png",
+             "detected_class": "scan_print",
+             "output_path": str(tmp_path / "a.out")},
+            {"job_id": "B", "status": "PENDING", "input_path": "b.png",
+             "detected_class": "scan_print",
+             "output_path": str(tmp_path / "b.out")}]
+    with open(manifest_path, "w", encoding="utf-8") as f:
+        for j in jobs:
+            f.write(json.dumps(j) + "\n")
+    ml.write_meta(manifest_path, {"total": len(jobs)}) if hasattr(
+        ml, "write_meta") else None
+
+    cfg_path = tmp_path / "cfg.yaml"
+    cfg_path.write_text("global:/n  temp_dir: .\n", encoding="utf-8")
+
+    observed = {"b_done_before_a": False}
+    release = threading.Event()
+
+    def fake_run_single_job(job, config_path, config, cli_params):
+        if job["job_id"] == "A":
+            # 轮询等待：B 的结果必须**已经在磁盘上**才放行
+            deadline = time.time() + 20
+            while time.time() < deadline:
+                doc = ml.load_manifest(manifest_path)
+                hit = [j for j in doc["jobs"] if j["job_id"] == "B"]
+                if hit and hit[0].get("status") == "DONE":
+                    observed["b_done_before_a"] = True
+                    break
+                time.sleep(0.05)
+            return 0
+        rc = 0
+        return rc
+
+    class _ThreadContext:
+        def Pool(self, processes=None):
+            return _mppool.ThreadPool(processes=processes or 2)
+
+    class _FakeMp:
+        @staticmethod
+        def get_context(_name=None):
+            return _ThreadContext()
+
+    # photo main 在函数内部 `import multiprocessing as mp` 后调用
+    # `mp.get_context('spawn')`，因此要 patch multiprocessing 模块本身。
+    monkeypatch.setattr(pmain, "_run_single_job", fake_run_single_job)
+    monkeypatch.setattr(_mp, "get_context", _FakeMp.get_context)
+    monkeypatch.setattr(sys, "argv",
+                        ["main.py", "--manifest", manifest_path,
+                         "--config", str(cfg_path), "--workers", "2"])
+
+    try:
+        pmain.main()
+    except SystemExit as e:
+        assert e.code in (0, None, 3), f"photo main 退出码异常：{e.code}"
+
+    assert observed["b_done_before_a"], (
+        "R2-05：job B 已经完成，但在 job A 结束前它的结果没有被落盘 —— "
+        "说明父进程仍按提交顺序阻塞收集（此时调度器退出就会丢掉 B 的状态）")
+    final = ml.load_manifest(manifest_path)
+    statuses = {j["job_id"]: j["status"] for j in final["jobs"]}
+    assert statuses.get("B") == "DONE", f"B 最终状态不对：{statuses}"
+    assert statuses.get("A") == "DONE", f"A 最终状态不对：{statuses}"
diff --git a/tests/test_stage6_encode_contract.py b/tests/test_stage6_encode_contract.py
new file mode 100644
index 0000000..80aae5a
--- /dev/null
+++ b/tests/test_stage6_encode_contract.py
@@ -0,0 +1,185 @@
+"""V02/V04 regression: photo stage6 colour + archival-master contracts."""
+
+import json
+import os
+
+import numpy as np
+import pytest
+from PIL import Image
+
+import conftest  # noqa: F401
+import stage6_encode as s6
+import media_io
+
+
+class _Log:
+    """Minimal logger stub capturing events."""
+
+    def __init__(self):
+        self.events = []
+
+    def _rec(self, name, msg, **kw):
+        self.events.append((name, msg))
+
+    info = warning = error = debug = _rec
+
+
+def _working_png(tmp_path, with_icc=False, size=(8, 8)):
+    p = tmp_path / "working.png"
+    img = Image.fromarray(
+        np.linspace(0, 255, size[0] * size[1] * 3, dtype=np.uint8)
+        .reshape(size[0], size[1], 3), mode="RGB")
+    kwargs = {}
+    if with_icc:
+        from PIL import ImageCms
+        kwargs["icc_profile"] = ImageCms.ImageCmsProfile(
+            ImageCms.createProfile("sRGB")).tobytes()
+    img.save(p, format="PNG", **kwargs)
+    return str(p)
+
+
+# --- V04 --------------------------------------------------------------------
+
+def test_v04_pillow_cannot_create_the_wide_gamut_profiles():
+    """Root-cause evidence: on-the-fly ADBE/ROMM creation is unsupported."""
+    from PIL import ImageCms
+    for name in ("ADBE", "ROMM"):
+        with pytest.raises(Exception):
+            ImageCms.createProfile(name)
+    ImageCms.createProfile("sRGB")  # sRGB is supported
+
+
+def test_v04_wide_gamut_without_profile_blocks_the_stage(tmp_path):
+    work = _working_png(tmp_path)
+    log = _Log()
+    color = s6.resolve_color_space(work, {"input_color_space": "adobergb"},
+                                   str(tmp_path), "j1", "clip", log)
+    assert color["status"] == s6.COLOR_FAILED
+    assert any(name == "STAGE6_COLOR_FAILED" for name, _ in log.events)
+
+
+def test_v04_degraded_encode_marks_cicp_unspecified(tmp_path):
+    work = _working_png(tmp_path)
+    log = _Log()
+    color = s6.resolve_color_space(
+        work, {"input_color_space": "adobergb",
+               "allow_unconverted_colorspace": True},
+        str(tmp_path), "j2", "clip", log)
+    assert color["status"] == s6.COLOR_DEGRADED
+    # R2-13（第三轮）契约变更 + 理由：
+    # 旧断言是 "2/2/0"（矩阵 0 = Identity）。实测（独立用例 A20）证明在
+    # **常规 YUV420** 下 avifenc 不会拒绝，而是警告后把 identity 矩阵 0 自动
+    # 改成 6 —— 于是保存的契约与真实文件头不一致。因此降级 CICP 必须按最终
+    # 布局选：archival/RGB444 → 2/2/0，常规 YUV → 2/2/1。
+    # 这里 archical 未开启（默认 False），故应为 YUV 形式。
+    assert color["cicp_override"] == "2/2/1", (
+        "degraded non-archival (YUV) encode must not claim an identity "
+        "matrix; avifenc rewrites 0 to 6 and the contract would be a lie")
+    assert not color["cicp_override"].startswith("1/13"), \
+        "must not claim sRGB primaries"
+    assert any(name == "STAGE6_COLOR_DEGRADED" for name, _ in log.events)
+
+
+def test_r213_degraded_archival_keeps_identity_matrix(tmp_path):
+    """R2-13 配套：archival（RGB444）路径下 identity 矩阵是**合法**的。
+
+    上一条断言 YUV 用 2/2/1；这一条确认 RGB444 仍用 2/2/0，
+    避免把上一条理解成"identity 一律禁止"。
+    """
+    work = _working_png(tmp_path)
+    log = _Log()
+    color = s6.resolve_color_space(
+        work, {"input_color_space": "adobergb",
+               "allow_unconverted_colorspace": True,
+               "archival_mode": True},
+        str(tmp_path), "j2a", "clip", log)
+    assert color["status"] == s6.COLOR_DEGRADED
+    assert color["cicp_override"] == "2/2/0", \
+        "RGB444 (archival) may legitimately use the identity matrix"
+
+
+def test_v04_real_profile_is_used_for_conversion(tmp_path):
+    """With a real (openable) profile the pixels are actually transformed.
+
+    Limitation recorded in the ledger: the profile used here is an sRGB stand-in
+    because no Adobe RGB profile is distributed with this environment; the
+    assertion covers the control flow (open → transform → new file), not colour
+    accuracy of Adobe RGB.
+    """
+    from PIL import ImageCms
+    icc_path = tmp_path / "source.icc"
+    icc_path.write_bytes(ImageCms.ImageCmsProfile(
+        ImageCms.createProfile("sRGB")).tobytes())
+    work = _working_png(tmp_path)
+    log = _Log()
+    color = s6.resolve_color_space(
+        work, {"input_color_space": "adobergb",
+               "source_icc_path": str(icc_path)},
+        str(tmp_path), "j3", "clip", log)
+    assert color["status"] == s6.COLOR_CONVERTED, log.events
+    assert color["working_path"].endswith("_srgb.png")
+    assert os.path.exists(color["working_path"])
+    assert color["precision"] == "8-bit"  # honest about CMS precision
+
+
+def test_v04_unknown_source_is_recorded_not_guessed(tmp_path):
+    work = _working_png(tmp_path)  # no embedded ICC, no metadata
+    log = _Log()
+    color = s6.resolve_color_space(work, {}, str(tmp_path), "j4", "clip", log)
+    assert color["status"] == s6.COLOR_UNKNOWN
+    assert any(name == "STAGE6_COLOR_UNKNOWN" for name, _ in log.events)
+
+    strict = s6.resolve_color_space(work, {"require_known_color_space": True},
+                                    str(tmp_path), "j5", "clip", _Log())
+    assert strict["status"] == s6.COLOR_FAILED
+
+
+def test_v04_srgb_declared_source_passes_through(tmp_path):
+    work = _working_png(tmp_path, with_icc=True)
+    color = s6.resolve_color_space(work, {"input_color_space": "srgb"},
+                                   str(tmp_path), "j6", "clip", _Log())
+    assert color["status"] == s6.COLOR_NOT_NEEDED
+    assert color["working_path"] == work
+
+
+# --- V02 --------------------------------------------------------------------
+
+def test_v02_master_records_real_precision_instead_of_claiming_16(tmp_path):
+    work = _working_png(tmp_path)  # 8-bit source
+    out = str(tmp_path / "master.tif")
+    info = s6.write_archival_master(work, out, {"photo_bit_depth": 16}, _Log())
+    assert info["written"] is True
+    assert info["actual_bit_depth"] == 8
+    assert info["precision_loss"] is True
+    assert info["icc"] in ("none", "source")
+
+    tifffile = pytest.importorskip("tifffile")
+    written = tifffile.imread(out)
+    assert written.dtype == np.uint8, "must not fake a 16-bit master"
+
+
+def test_v02_16bit_source_keeps_16bit(tmp_path):
+    tifffile = pytest.importorskip("tifffile")
+    src = tmp_path / "src16.tif"
+    arr = np.zeros((6, 6, 3), dtype=np.uint16)
+    arr[..., 0] = np.arange(36, dtype=np.uint16).reshape(6, 6) * 100
+    media_io.write_tiff(str(src), arr)
+    out = str(tmp_path / "master16.tif")
+    info = s6.write_archival_master(str(src), out, {"photo_bit_depth": 16},
+                                    _Log())
+    assert info["actual_bit_depth"] == 16
+    assert info["precision_loss"] is False
+    assert tifffile.imread(out).dtype == np.uint16
+
+
+def test_v02_no_system_icc_is_pasted_on(tmp_path):
+    """A profile may only be attached when it belongs to these pixels."""
+    work = _working_png(tmp_path)  # no ICC in file
+    out = str(tmp_path / "master_noicc.tif")
+    info = s6.write_archival_master(work, out, {"photo_bit_depth": 16}, _Log())
+    assert info["icc"] == "none"
+    tifffile = pytest.importorskip("tifffile")
+    # tag 34675 (ICC profile) must be absent
+    with tifffile.TiffFile(out) as tf:
+        tags = [t.code for p in tf.pages for t in p.tags.values()]
+    assert 34675 not in tags
