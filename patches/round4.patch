+        f"enable='between(t,{t},{t + 0.08})'" for t in _EVENT_TIMES)
+    r = subprocess.run(
+        ["ffmpeg", "-v", "error", "-y", "-f", "lavfi",
+         "-i", f"color=c=black:s=64x64:d={duration}:r={fps}",
+         "-vf", vf, "-c:v", "ffv1", "-pix_fmt", "yuv420p", str(video)],
+        capture_output=True, text=True, timeout=120)
