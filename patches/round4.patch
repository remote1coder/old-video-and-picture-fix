+    import numpy as _np
+    n = int(duration * sr)
+    pcm = _np.zeros(n, dtype=_np.int16)
+    for t in _EVENT_TIMES:
+        start = int(t * sr)
+        pcm[start:start + int(0.02 * sr)] = 30000
